# Example Supabase environment variables (DO NOT commit real keys here)
# Copy this file to .env.local and fill in real values locally.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-side keys (keep these secret and only in your local .env.local)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Direct Postgres connection used by `npm run db:migrate` (Dashboard > Connect > Direct connection).
# If your network has no IPv6, use the Session pooler string (port 5432) instead.
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project.supabase.co:5432/postgres
